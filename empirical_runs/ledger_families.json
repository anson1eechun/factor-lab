    {"kind": "defect",     "factor": "^\\[流程缺陷"},
    {"kind": "void",       "factor": "^\\[汙染版|作廢"},
    {"kind": "correction", "factor": "^\\[更正"},
    {"kind": "lock_fail",  "factor": "^\\[lock-FAIL"},
    {"kind": "gate",       "factor": "預註冊閘門"},
    {"kind": "risk",       "factor": "對 book 相關性|邊際 Sharpe|容量|控制變數自身|zero_cost|fixed_weight|P&L 集中度|spanning|多頭腿對"}
  ],
  "count_toward_n": ["trial", "lock_fail"]
}
