//@version=5
// SMC + POC 多空標註 [factor-lab]
// 結構(BOS/CHoCH)+ Order Block + FVG 進場,POC 偏向過濾;
// 圖上標 LONG/SHORT、SL、TP1(前擺動點流動性)、TP2(盈虧比),
// 並以指標自身統計的歷史命中率標註目標「可能性」(in-sample,非驗證過的 edge)。
indicator("SMC + POC 多空標註 [factor-lab]", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ───────── 輸入 ─────────
swingLen  = input.int(10,    "擺動點窗口 (pivot)",      minval = 2)
pocLen    = input.int(240,   "POC 回看根數",            minval = 50)
pocRows   = input.int(48,    "POC 分箱數",              minval = 10, maxval = 96)
fvgMinAtr = input.float(0.5, "FVG 最小高度 (×ATR)",     step = 0.1)
obScan    = input.int(15,    "OB 回掃根數",             minval = 3)
maxZones  = input.int(5,     "每側保留 zone 數",        minval = 1, maxval = 20)
rrMult    = input.float(2.0, "TP2 盈虧比",              step = 0.5)
slBufAtr  = input.float(0.1, "SL 緩衝 (×ATR)",          step = 0.05)
showZones = input.bool(true, "畫 OB/FVG zone")
showStruc = input.bool(true, "標 BOS/CHoCH")

atr = ta.atr(14)

// ───────── 市場結構:擺動點 / BOS / CHoCH ─────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)
var float lastSH = na
var float lastSL = na
if not na(ph)
    lastSH := ph
if not na(pl)
    lastSL := pl

var int trend = 0
bullBOS = not na(lastSH) and ta.crossover(close, lastSH)
bearBOS = not na(lastSL) and ta.crossunder(close, lastSL)
chochUp = trend == -1 and bullBOS
chochDn = trend ==  1 and bearBOS
if bullBOS
    trend := 1
if bearBOS
    trend := -1

if showStruc and bullBOS
    label.new(bar_index, low, chochUp ? "CHoCH▲" : "BOS▲", style = label.style_label_up,
         color = color.new(color.teal, 60), textcolor = color.white, size = size.tiny)
if showStruc and bearBOS
    label.new(bar_index, high, chochDn ? "CHoCH▼" : "BOS▼", style = label.style_label_down,
         color = color.new(color.maroon, 60), textcolor = color.white, size = size.tiny)

// ───────── POC:滾動成交量分布最大箱 ─────────
f_poc(len, rows) =>
    float hi = ta.highest(high, len)
    float lo = ta.lowest(low, len)
    float res = na
    float stp = (hi - lo) / rows
    if not na(stp) and stp > 0 and bar_index >= len
        vols = array.new_float(rows, 0.0)
        for i = 0 to len - 1
            int idx = int((hl2[i] - lo) / stp)
            idx := math.min(rows - 1, math.max(0, idx))
            array.set(vols, idx, array.get(vols, idx) + volume[i])
        int best = 0
        for j = 1 to rows - 1
            if array.get(vols, j) > array.get(vols, best)
                best := j
        res := lo + (best + 0.5) * stp
    res

poc = f_poc(pocLen, pocRows)
plot(poc, "POC", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)

// ───────── zone 工具 ─────────
f_extend(arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            box.set_right(array.get(arr, i), bar_index)

f_pushCap(arr, b, cap) =>
    array.push(arr, b)
    if array.size(arr) > cap
        box.delete(array.shift(arr))

// 失效清理:多頭 zone 收破下緣即死;空頭 zone 收破上緣即死
f_purge(arr, isBull) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0 by -1
            b = array.get(arr, i)
            bool dead = isBull ? close < box.get_bottom(b) : close > box.get_top(b)
            if dead
                box.delete(b)
                array.remove(arr, i)

// tap+拒絕:多頭 = 影線探進 zone、收盤收回中線上;回傳該 zone 下緣(做 SL)
f_tapLong(arr) =>
    float zBot = na
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0 by -1
            b = array.get(arr, i)
            t = box.get_top(b)
            bo = box.get_bottom(b)
            if low <= t and close >= (t + bo) / 2 and close > bo
                zBot := bo
                break
    zBot

f_tapShort(arr) =>
    float zTop = na
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0 by -1
            b = array.get(arr, i)
            t = box.get_top(b)
            bo = box.get_bottom(b)
            if high >= bo and close <= (t + bo) / 2 and close < t
                zTop := t
                break
    zTop

// ───────── Order Block:BOS 衝刺前最後一根反向 K ─────────
var box[] bullObs  = array.new<box>()
var box[] bearObs  = array.new<box>()
var box[] bullFvgs = array.new<box>()
var box[] bearFvgs = array.new<box>()

if bullBOS
    int k = na
    for i = 1 to obScan
        if close[i] < open[i]
            k := i
            break
    if not na(k) and showZones
        f_pushCap(bullObs, box.new(bar_index - k, high[k], bar_index, low[k],
             bgcolor = color.new(color.teal, 85), border_color = color.new(color.teal, 50)), maxZones)
if bearBOS
    int k = na
    for i = 1 to obScan
        if close[i] > open[i]
            k := i
            break
    if not na(k) and showZones
        f_pushCap(bearObs, box.new(bar_index - k, high[k], bar_index, low[k],
             bgcolor = color.new(color.maroon, 85), border_color = color.new(color.maroon, 50)), maxZones)

// ───────── FVG(三根缺口,ATR 過濾)─────────
if showZones and low > high[2] and (low - high[2]) > fvgMinAtr * atr
    f_pushCap(bullFvgs, box.new(bar_index - 2, low, bar_index, high[2],
         bgcolor = color.new(color.aqua, 88), border_color = color.new(color.aqua, 60)), maxZones)
if showZones and high < low[2] and (low[2] - high) > fvgMinAtr * atr
    f_pushCap(bearFvgs, box.new(bar_index - 2, low[2], bar_index, high,
         bgcolor = color.new(color.fuchsia, 88), border_color = color.new(color.fuchsia, 60)), maxZones)

f_extend(bullObs)
f_extend(bearObs)
f_extend(bullFvgs)
f_extend(bearFvgs)
f_purge(bullObs, true)
f_purge(bullFvgs, true)
f_purge(bearObs, false)
f_purge(bearFvgs, false)

// ───────── 命中率追蹤(先解決舊單,再找新訊號)─────────
var int   dir = 0
var int   entryBar = na
var float eP = na, sP = na, t1 = na, t2 = na
var bool  done1 = false, done2 = false
var int n1L = 0, w1L = 0, n2L = 0, w2L = 0
var int n1S = 0, w1S = 0, n2S = 0, w2S = 0

if dir != 0 and bar_index > entryBar
    bool hitSL = dir == 1 ? low <= sP : high >= sP
    bool hitT1 = dir == 1 ? high >= t1 : low <= t1
    bool hitT2 = dir == 1 ? high >= t2 : low <= t2
    // 同根同時觸及 → 保守記停損優先
    if not done1
        if hitSL
            done1 := true
            if dir == 1
                n1L += 1
            else
                n1S += 1
        else if hitT1
            done1 := true
            if dir == 1
                n1L += 1
                w1L += 1
            else
                n1S += 1
                w1S += 1
    if not done2
        if hitSL
            done2 := true
            if dir == 1
                n2L += 1
            else
                n2S += 1
        else if hitT2
            done2 := true
            if dir == 1
                n2L += 1
                w2L += 1
            else
                n2S += 1
                w2S += 1
    if done1 and done2
        dir := 0

f_pct(w, n) => n >= 10 ? str.tostring(100.0 * w / n, "#.0") + "%" : "樣本<10"

// ───────── 進出場訊號 ─────────
float slzL = f_tapLong(bullObs)
float slzLf = f_tapLong(bullFvgs)
float zBotL = na(slzL) ? slzLf : na(slzLf) ? slzL : math.min(slzL, slzLf)
float slzS = f_tapShort(bearObs)
float slzSf = f_tapShort(bearFvgs)
float zTopS = na(slzS) ? slzSf : na(slzSf) ? slzS : math.max(slzS, slzSf)

longSig  = barstate.isconfirmed and dir == 0 and trend == 1  and not na(zBotL) and not na(poc) and close > poc
shortSig = barstate.isconfirmed and dir == 0 and trend == -1 and not na(zTopS) and not na(poc) and close < poc

if longSig
    eP := close
    sP := zBotL - slBufAtr * atr
    float risk = eP - sP
    t1 := not na(lastSH) and lastSH > eP ? lastSH : eP + risk
    t2 := eP + rrMult * risk
    dir := 1
    entryBar := bar_index
    done1 := false
    done2 := false
    label.new(bar_index, low, "LONG @" + str.tostring(eP, format.mintick) +
         "\nSL " + str.tostring(sP, format.mintick) +
         "\nTP1 " + str.tostring(t1, format.mintick) + " (" + f_pct(w1L, n1L) + ")" +
         "\nTP2 " + str.tostring(t2, format.mintick) + " (" + f_pct(w2L, n2L) + ")",
         style = label.style_label_up, color = color.new(color.green, 20), textcolor = color.white, size = size.small)
    line.new(bar_index, sP, bar_index + 20, sP, color = color.red,   width = 2)
    line.new(bar_index, t1, bar_index + 20, t1, color = color.green, width = 1, style = line.style_dashed)
    line.new(bar_index, t2, bar_index + 20, t2, color = color.green, width = 2)

if shortSig
    eP := close
    sP := zTopS + slBufAtr * atr
    float risk = sP - eP
    t1 := not na(lastSL) and lastSL < eP ? lastSL : eP - risk
    t2 := eP - rrMult * risk
    dir := -1
    entryBar := bar_index
    done1 := false
    done2 := false
    label.new(bar_index, high, "SHORT @" + str.tostring(eP, format.mintick) +
         "\nSL " + str.tostring(sP, format.mintick) +
         "\nTP1 " + str.tostring(t1, format.mintick) + " (" + f_pct(w1S, n1S) + ")" +
         "\nTP2 " + str.tostring(t2, format.mintick) + " (" + f_pct(w2S, n2S) + ")",
         style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.small)
    line.new(bar_index, sP, bar_index + 20, sP, color = color.red,   width = 2)
    line.new(bar_index, t1, bar_index + 20, t1, color = color.green, width = 1, style = line.style_dashed)
    line.new(bar_index, t2, bar_index + 20, t2, color = color.green, width = 2)

// ───────── 統計面板 ─────────
var tbl = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 30))
if barstate.islast
    table.cell(tbl, 0, 0, "趨勢",  text_color = color.gray,  text_size = size.tiny)
    table.cell(tbl, 1, 0, trend == 1 ? "多 ▲" : trend == -1 ? "空 ▼" : "—",
         text_color = trend == 1 ? color.teal : trend == -1 ? color.red : color.gray, text_size = size.tiny)
    table.cell(tbl, 0, 1, "價 vs POC", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 1, na(poc) ? "—" : close > poc ? "POC 上" : "POC 下",
         text_color = color.orange, text_size = size.tiny)
    table.cell(tbl, 0, 2, "多單 TP1/TP2", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 2, f_pct(w1L, n1L) + " / " + f_pct(w2L, n2L) + "  (n=" + str.tostring(n1L) + ")",
         text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 0, 3, "空單 TP1/TP2", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 3, f_pct(w1S, n1S) + " / " + f_pct(w2S, n2S) + "  (n=" + str.tostring(n1S) + ")",
         text_color = color.white, text_size = size.tiny)

// 提醒:命中率為本圖表歷史 in-sample 統計(同根觸及以停損優先,保守計),
// factor-lab 閘門下此類 SMC 訊號扣成本後未驗證出 alpha——本指標定位為人工判讀輔助。
alertcondition(longSig,  "SMC+POC Long",  "SMC+POC LONG signal")
alertcondition(shortSig, "SMC+POC Short", "SMC+POC SHORT signal")
